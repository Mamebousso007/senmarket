# Copie ce fichier en .env (qui, lui, n'est JAMAIS commité), puis adapte les valeurs.
# Dossier des données (relatif à la racine du projet, ou absolu)
SENMARKET_DATA_DIR=data
# Graine de base : la graine réelle est dérivée de cette valeur ET de la date d'exécution
SENMARKET_SEED=42
# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR
SENMARKET_LOG_LEVEL=INFO
